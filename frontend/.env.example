# =====================================
# VARIABLES DE ENTORNO - FRONTEND
# =====================================

# URLs de APIs Backend
VITE_API_QR_URL=http://localhost:8001
VITE_API_UBICACION_URL=http://localhost:8002

# Debug Mode (mostrar logs en consola)
VITE_DEBUG=false

# =====================================
# NOTAS:
# =====================================
# 1. Renombra este archivo a .env en la raíz del proyecto frontend
# 2. Actualiza las URLs según tu configuración de backend
# 3. En producción, usar URLs del servidor final
# 4. Nunca commitear .env a git (agregar a .gitignore)
